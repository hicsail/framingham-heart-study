NODE_ENV=production
PROJECT_NAME=FHS
BASE_URL=https://broc-review.sail.codes/
PORT=9000

# Authentication
AUTH_SECRET=your-auth-secret-here

# MongoDB (fhs-mongo is the service name in docker-compose)
MONGODB_URI=mongodb://fhs-mongo:27017/
MONGODB_DB_NAME=fhs

# Mailgun
MAILGUN_APIKEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain

# AWS S3
BUCKET_NAME=fhs-broc
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
